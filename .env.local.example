# Android APK Signing Credentials
# Copy this file to .env.local and fill in your actual values

# Keystore password (password for the .jks file)
KEYSTORE_PASSWORD=your-keystore-password-here

# Key alias (the alias name you used when creating the keystore)
KEY_ALIAS=pospro

# Key password (password for the specific key, often same as keystore password)
KEY_PASSWORD=your-key-password-here

# Optional: GitHub token with contents:write on murrentronics/pos-pro
# Used by `npm run publish:release` to upload the APK and Windows EXE to the public repo.
# GH_RELEASE_TOKEN=ghp_xxxxxxxx
